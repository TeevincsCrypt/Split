# Split — environment variables
# Copy this file to .env and fill in your values.

# "testnet" | "mainnet"
VITE_SPLIT_NETWORK=testnet

# SplitDistributor contract address on the active network
# Arc Testnet: 0x43a159af83f4c836940e2e74c8a29ae677c39498
VITE_SPLIT_DISTRIBUTOR_ADDRESS=0x43a159af83f4c836940e2e74c8a29ae677c39498

# Block at which SplitDistributor was deployed (getLogs fromBlock)
# Arc Testnet deploy block: 69249404
VITE_SPLIT_DEPLOY_BLOCK=69249404

# Optional: override the RPC endpoint for the active network.
# Use this when the default Arc RPC is permissioned or unavailable.
# Must be an https URL. Leave empty to use the default Arc RPC.
# Example: VITE_SPLIT_RPC_URL=https://your-rpc-provider.com/arc-testnet
VITE_SPLIT_RPC_URL=

# ScheduledSplit contract address on the active network
# Arc Testnet: 0xf43192c85c5888c7b01fe7257efb80f6de2e17d6
# Leave empty to hide the scheduling feature.
VITE_SCHEDULED_SPLIT_ADDRESS=0xf43192c85c5888c7b01fe7257efb80f6de2e17d6

# Block at which ScheduledSplit was deployed (getLogs fromBlock)
# Arc Testnet deploy block: 69445979
VITE_SCHEDULED_SPLIT_DEPLOY_BLOCK=69445979
